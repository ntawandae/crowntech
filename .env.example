# Copy this file to .env and fill it in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-domain.example      # no trailing slash; must be reachable from the internet
SESSION_COOKIE_SECURE=true                        # true once the site is on https

BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=                                # e.g. 263771234567 (digits only)

# Paynow  (Paynow dashboard > My Account > Integration)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_TEST_EMAIL=                                # your Paynow login email, only while in test mode

# PayPal  (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                               # switch to live when you go live

DELIVERY_FEE=0

# Till: largest discount (% of the subtotal) a cashier may give. 0 = no limit. Admins are never limited.
CASHIER_MAX_DISCOUNT_PERCENT=0

# Email (Aliyun Direct Mail). Leave MAIL_SERVER empty while developing: emails are printed and saved in instance/outbox/.
# Take the server, port and sender details from your Direct Mail console once crowntechhub.co.zw is verified there.
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=info@crowntechhub.co.zw
MAIL_PASSWORD=
MAIL_FROM=info@crowntechhub.co.zw
MAIL_FROM_NAME=Crown Tech Hub

# Sign in with Google (customers). console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI to add:  https://crowntechhub.co.zw/account/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
