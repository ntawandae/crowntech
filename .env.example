# Copy this file to .env and fill it in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-domain.example      # no trailing slash; must be reachable from the internet
SESSION_COOKIE_SECURE=true                        # true once the site is on https

BUSINESS_PHONE=
BUSINESS_EMAIL=info@crowntechhub.co.zw
BUSINESS_WEBSITE=www.crowntechhub.co.zw
# Phone numbers shown on PDFs (receipts, quotations, catalogue, stock list), comma separated
BUSINESS_PHONES=+263 77 465 9090, +263 78 289 6646, +263 77 832 9323
# "Valid until" on quotations, in days (0 = don't show)
QUOTATION_VALID_DAYS=14
BUSINESS_WHATSAPP=                                # e.g. 263771234567 (digits only)

# Paynow  (Paynow dashboard > My Account > Integration)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_TEST_EMAIL=                                # your Paynow login email, only while in test mode

# PayPal  (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                               # switch to live when you go live

DELIVERY_FEE=0

# Till: largest discount (% of the subtotal) a cashier may give. 0 = no limit. Admins are never limited.
CASHIER_MAX_DISCOUNT_PERCENT=0

# Email through the Alibaba Direct Mail HTTPS API (recommended; works on Render). Create a RAM user AccessKey with dm:SingleSendMail.
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
# hangzhou / singapore / sydney: the region where the sender address was created
ALIYUN_DM_REGION=singapore

# Or email through SMTP (Aliyun Direct Mail). Leave MAIL_SERVER empty while developing: emails are printed and saved in instance/outbox/.
# Server names by region: smtpdm.aliyun.com (Hangzhou), smtpdm-ap-southeast-1.aliyuncs.com (Singapore),
# smtpdm-us-east-1.aliyuncs.com (Virginia), smtpdm-eu-central-1.aliyuncs.com (Frankfurt).
# On Render's free plan use port 80 + STARTTLS (ports 25/465/587 are blocked there). See docs/EMAIL_SETUP_RENDER.md
MAIL_SERVER=
MAIL_PORT=80
MAIL_USE_SSL=false
MAIL_USE_TLS=true
MAIL_USERNAME=info@crowntechhub.co.zw
MAIL_PASSWORD=
MAIL_FROM=info@crowntechhub.co.zw
MAIL_FROM_NAME=Crown Tech Hub

# Sign in with Google (customers). console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI to add in Google Cloud Console (must match GOOGLE_REDIRECT_URI exactly,
# and use the same host your visitors browse, e.g. www):
#   https://www.crowntechhub.co.zw/account/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.crowntechhub.co.zw/account/google/callback

# Social media links shown in the shop footer. Leave any of these empty to hide that icon.
# Use the full page address, e.g. https://www.facebook.com/yourpage
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=

# Supabase Storage for product photos and staff contracts (see docs/SUPABASE_STORAGE_SETUP.md).
# URL looks like https://abcdxyz.supabase.co  -  the service key is secret: keep it only on Render.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_DOCS_BUCKET=staff-documents

# Ask for confirmation before recording a near-identical sale/expense/income within this many minutes (0 = off)
DUPLICATE_WINDOW_MINUTES=10

# Render: set these too
BEHIND_PROXY=true
