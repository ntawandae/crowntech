# Copy this file to .env and fill it in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-domain.example      # no trailing slash; must be reachable from the internet
SESSION_COOKIE_SECURE=true                        # true once the site is on https

BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=                                # e.g. 263771234567 (digits only)

# Paynow  (Paynow dashboard > My Account > Integration)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_TEST_EMAIL=                                # your Paynow login email, only while in test mode

# PayPal  (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                               # switch to live when you go live

DELIVERY_FEE=0
